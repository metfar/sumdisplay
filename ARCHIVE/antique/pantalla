#!/bin/bash
APP=$(basename $0) ;
DISP=$(xrandr | grep "connected"|grep -v "disconnected"|cut -f1 -d\ |head -1 ) ;
RES=$(xrandr | grep "connected"|grep -v "disconnected"|cut -f3 -d\ |head -1 ) ;

case "$1" in
	grande|	big)
			xrandr --output $DISP --scale-from 1920x1080 	;;
	delgada|light)
			xrandr --output $DISP --scale-from 1600x768 	;;
	normal|restore|restaura)
			xrandr --output $DISP --scale 1x1 ;;
	status|estado)
			echo -en "DISPLAY:     $DISP\nResolution: $RES\n\n";;
	*)
			echo -en "$APP "'[big|grande|light|delgada|normal|restore|restaura|status|estado]'"\n\n";
			echo -en "$APP big\t\t1920x1080\n$APP light\t\t1680x768\n$APP restore\tscale to 1x1\n\n";;
esac ;
